# Credentials - never commit. The sandbox API key, secret and passphrase live
# in config/creds.env (one file, one credential, three services), chmod 600.
*.env
# ...except the simulator settings, which are fake and belong in the project.
# Named one by one, not config/*.env: a blanket negation would have made the
# real credentials in config/ committable the moment they were put there.
!config/sim.env
!config/oe-sim.env

# Build output
build*/
*.o
*.a
*.so
compile_commands.json
CMakeUserPresets.json

# QuickFIX runtime state, if a session is ever configured with file
# persistence instead of the in-memory store.
log/
store/

# Client runtime state: the last ExecID / ClOrdID counter each app resumes
# from (--bookmark), and the sidecar the daemon flocks to keep a second
# daemon off that state. The lock file is runtime, not configuration: it
# holds nothing once the process that took it is gone.
*-bookmark.txt
*.lock

# Editor and OS noise
*.swp
*~
.idea/
.vscode/
.DS_Store
core
core.*

# Scratch / working area: the vendor API spec PDF, the project brief and the
# throwaway logon probe. Local reference only, not part of the repo.
Temp/

# The design record and the vendor spec. Local reference only, like Temp/:
# the documents are written for this machine and the spec PDF is the
# vendor's to distribute, not ours.
docs/

# clangd's index, which comes along with compile_commands.json above.
.cache/
.ccls-cache/

# Test leftovers. Each live test writes its own bookmark next to itself,
# named with its pid, and unlinks it only if it reaches tear-down.
*-bookmark-*.txt

# Coverage and profiler output.
*.gcda
*.gcno
*.gcov
perf.data
perf.data.old
callgrind.out.*
massif.out.*
vgcore.*
