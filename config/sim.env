# Local simulator settings for md_sim and md_client. FAKE credentials, safe to
# keep in the project: they only work against md_sim on this machine.
#   terminal 1:  source config/sim.env && ./build/marketdata/md_sim
#   terminal 2:  source config/sim.env && ./build/marketdata/md_client --capture SIMGAME-26NOV01HOMAWY-HOM
export CPM_API_KEY=sim-test-key-0001
export CPM_PASSPHRASE=sim-test-passphrase
export CPM_SECRET=c2ltLXRlc3Qtc2VjcmV0LW5vdC1yZWFs
export CPM_FIX_HOST=127.0.0.1
export CPM_FIX_PORT=6121
export CPM_FIX_TLS=0
# md_sim plays this comp id and md_client targets it; keep both in step.
export CPM_FIX_TARGET_COMP_ID=CPMMD
