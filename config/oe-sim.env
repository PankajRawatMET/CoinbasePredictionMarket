# Local order entry simulator settings for oe_sim and oe_client. FAKE
# credentials, safe to keep in the project: they only work against oe_sim on
# this machine.
#   terminal 1:  source config/oe-sim.env && ./build/order_management/oe_sim
#   terminal 2:  source config/oe-sim.env && ./build/order_management/oe_client \
#                  --allow-orders --test-order SIMOE-26NOV01HOMAWY-HOM --price 0.4
export CPM_OE_API_KEY=oe-sim-key-0001
export CPM_OE_PASSPHRASE=oe-sim-passphrase
export CPM_OE_SECRET=b2Utc2ltLXNlY3JldC1ub3QtcmVhbA==
export CPM_OE_HOST=127.0.0.1
export CPM_OE_PORT=6111
export CPM_OE_TLS=0
export CPM_OE_TARGET_COMP_ID=CPMOE
export CPM_OE_SUBACCOUNT=dev-1
# The simulator has no cancel-on-disconnect, so this only affects what the
# client sends on Logon.
export CPM_OE_CANCEL_ON_DISCONNECT=N
export CPM_OE_SETTLEMENT_REPORTS=Y
export CPM_OE_MANUAL_ORDERS=N
