# Turns a file into a C++ translation unit holding its bytes, so the page is
# part of the binary and there is no runtime asset path to get wrong and no
# file-serving code path to review (GUI-Q8).
#
#   cmake -DINPUT=... -DOUTPUT=... -DFUNCTION=... -DHEADER=... -P EmbedFile.cmake
#
# Bytes rather than a raw string literal: a raw literal has a delimiter that
# the file could contain, and HTML containing )" is not a build error anyone
# should have to debug.

file(READ "${INPUT}" hex HEX)
string(REGEX MATCHALL "[0-9a-f][0-9a-f]" bytes "${hex}")
list(LENGTH bytes count)
if(count EQUAL 0)
  set(literal "0")  # an empty file still needs a well-formed array
else()
  list(JOIN bytes ",0x" body)
  set(literal "0x${body}")
endif()

file(WRITE "${OUTPUT}"
"// Generated by cmake/EmbedFile.cmake from ${INPUT}. Do not edit.
#include \"${HEADER}\"

namespace cpm::gui {
namespace {
// unsigned, because a byte over 0x7f is narrowing into a plain char
// and the page is UTF-8.
const unsigned char kBytes[] = {${literal}};
}  // namespace

std::string_view ${FUNCTION}() {
    return std::string_view(reinterpret_cast<const char*>(kBytes), ${count});
}

}  // namespace cpm::gui
")
